{
  "name": "sms-platform-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "worker": "ts-node-dev --respawn --transpile-only src/worker/purchase.worker.ts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "lint": "eslint . --ext .ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "e2e": "playwright test --project=chromium",
    "prepare": "husky install",
    "seed": "ts-node --transpile-only scripts/seed.ts",
    "create-admin-api-key": "ts-node --transpile-only scripts/create-admin-api-key.ts",
    "purge-retention": "ts-node --transpile-only scripts/purge-retention.ts"
  },
  "dependencies": {
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/swagger": "^6.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/client": "^5.0.0",
    "argon2": "^0.32.0",
    "axios": "^1.4.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^2.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "helmet": "^6.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "minio": "^8.0.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.14.0",
    "prisma": "^5.0.0",
    "prom-client": "^14.0.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "stripe": "^16.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.0"
  }
}
