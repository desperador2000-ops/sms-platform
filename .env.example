# Copy this to .env and fill in values
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sms_platform

# Redis / BullMQ
REDIS_URL=redis://localhost:6379/0
BULLMQ_PREFIX=sms_platform

# JWT
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# AES
AES_MASTER_KEY=replace_with_base64_32_byte_key

# Email
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM=no-reply@yourdomain.com

# Frontend
FRONTEND_ORIGIN=http://localhost:3000

# Metrics
METRICS_ENABLED=true
PROVIDER_RATE_LIMITS={"TWILIO":{"maxConcurrent":5,"minTime":200},"TELNYX":{"maxConcurrent":2,"minTime":500}}

# Providers
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WEBHOOK_SECRET=your_twilio_webhook_secret

VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_WEBHOOK_SECRET=your_vonage_webhook_secret

TELNYX_API_KEY=key_xxxxxxxxx
TELNYX_WEBHOOK_SECRET=your_telnyx_webhook_secret
TELNYX_MESSAGING_PROFILE_ID=optional_profile_id

AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_WEBHOOK_SECRET=your_webhook_secret

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_xxx
FLUTTERWAVE_WEBHOOK_SECRET=xxx

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Sentry
SENTRY_DSN=
